{
  "name": "metrodripjs",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "python3 web/dev_server.py 3000",
    "web:server": "python3 web/dev_server.py 3000",
    "test:client": "node --test \"tests/client/*.test.mjs\"",
    "test:browser": "node tests/browser/run-console-layout.mjs",
    "test:customer": "node tests/browser/run-customer-integration.mjs",
    "test:merchant:banners": "node tests/browser/run-merchant-banners.mjs",
    "test:browser:integration": "node tests/browser/run-console-integration.mjs",
    "test:load:local": "node tests/performance/run-local-api-smoke.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "android:run": "expo run:android",
    "eas:config:android:preview": "npx --yes eas-cli@25.2.0 config --platform android --profile preview --eas-json-only",
    "eas:build:android:preview": "npx --yes eas-cli@25.2.0 build --platform android --profile preview",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/anton": "^0.4.2",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/drawer": "^7.13.10",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "expo": "~54.0.36",
    "expo-build-properties": "~1.0.10",
    "expo-font": "~14.0.12",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "private": true,
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
