{
  "expo": {
    "name": "MetroDripJS",
    "slug": "MetroDripJS",
    "scheme": "metrodripjs",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./mobile/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./mobile/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#141414"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.metrodrip.js",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.metrodrip.js",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./mobile/assets/adaptive-icon.png",
        "backgroundColor": "#141414"
      },
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "metrodripjs.onrender.com",
              "pathPrefix": "/payment/return"
            },
            {
              "scheme": "https",
              "host": "metrodripjs.onrender.com",
              "pathPrefix": "/customer/orders"
            },
            {
              "scheme": "https",
              "host": "metrodripjs-q4ik.onrender.com",
              "pathPrefix": "/payment/return"
            },
            {
              "scheme": "https",
              "host": "metrodripjs-q4ik.onrender.com",
              "pathPrefix": "/customer/orders"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./web/assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./mobile/assets/adaptive-icon.png",
          "color": "#141414"
        }
      ]
    ]
  }
}
