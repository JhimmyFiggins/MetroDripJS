{
  "expo": {
    "name": "MetroDripJS",
    "slug": "MetroDripJS",
    "scheme": "metrodripjs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./web/assets/favicon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./web/assets/favicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#141414"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.metrodrip.js"
    },
    "android": {
      "package": "com.metrodrip.js",
      "adaptiveIcon": {
        "foregroundImage": "./web/assets/favicon.png",
        "backgroundColor": "#141414"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./web/assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
