# ==============================================================================
# MetroDrip Backend Environment Configuration Template
# ==============================================================================

DJANGO_SECRET_KEY=django-insecure-dev-backend-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.onrender.com
DATABASE_URL=sqlite:///db.sqlite3

# Cloudinary Durable Storage (Free Tier)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DJANGO_MEDIA_STORAGE_BACKEND=metrodrip_backend.storage.CloudinaryMediaStorage
DJANGO_MEDIA_STORAGE_DURABLE=true

# PayMongo (Test)
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_ENABLED_METHODS=gcash,maya,card

# Brevo (Email OTP)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@metrodrip.local
BREVO_SENDER_NAME=MetroDrip
EMAIL_OTP_ENFORCED=true

