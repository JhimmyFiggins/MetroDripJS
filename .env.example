# ==============================================================================
# MetroDripJS Environment Configuration Template
# Copy this file to .env (or .env.local for local overrides) and supply values.
# NEVER commit real production secrets, API keys, or private tokens to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend / Expo Configuration
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
# For Android Emulator local testing:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=django-insecure-local-dev-key-change-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.onrender.com
DATABASE_URL=sqlite:///db.sqlite3

# ------------------------------------------------------------------------------
# Durable Media Storage (Cloudinary Free Tier)
# Required on Render Free to ensure product images and banners survive restarts.
# In local development (DEBUG=True), FileSystemStorage is permitted by default.
# ------------------------------------------------------------------------------
# Option A: Full Cloudinary URL
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Option B: Individual credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Storage backend overrides (defaults automatically to CloudinaryMediaStorage when configured)
# DJANGO_MEDIA_STORAGE_BACKEND=metrodrip_backend.storage.CloudinaryMediaStorage
# DJANGO_MEDIA_STORAGE_DURABLE=true

# ------------------------------------------------------------------------------
# PayMongo Payment Gateway (Test / Live)
# ------------------------------------------------------------------------------
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_ENABLED_METHODS=gcash,maya,card

# ------------------------------------------------------------------------------
# Brevo Email OTP & Order Confirmation
# ------------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@metrodrip.local
BREVO_SENDER_NAME=MetroDrip
EMAIL_OTP_ENFORCED=true
EMAIL_OTP_TTL_SECONDS=300
EMAIL_OTP_RESEND_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800

